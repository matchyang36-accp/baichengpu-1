{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baichengpu",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "edit-photo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.edit-photo.com",
      "custom_domain": true
    },
    {
      "pattern": "app.edit-photo.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baichengpu-db",
      "database_id": "ef6ebcb8-af27-448d-911a-b12b2454111b",
      "migrations_dir": "drizzle"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
